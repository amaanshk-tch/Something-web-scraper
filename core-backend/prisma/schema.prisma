generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  jobs         Job[]
  sessions     Session[]
}


model Session {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String?   @unique
  userAgent       String?
  ipAddress       String?
  deviceName      String?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime

  @@index([userId, revokedAt])
}

enum JobStatus {
  QUEUED
  PLANNING
  SEARCHING
  FETCHING
  ANALYZING
  SYNTHESIZING
  GENERATING_REPORT
  COMPLETED
  FAILED
  CANCELLED
}

model Job {
  id            String    @id @default(uuid())
  userId        String
  requestId     String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic         String
  keywords      String[]
  depth         Int       @default(5)
  status        JobStatus @default(QUEUED)
  sentimentData Json?
  bullets       String[]
  errorMessage  String?
  errorCode     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  results       Source[]
  concepts      Concept[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  // Speeds up per-user job lookups by primary key (polling + presentation endpoints)
  @@index([id, userId])
}

model Concept {
  id           String   @id @default(uuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  canonical    String
  aliases      String[] @default([])
  conceptType  String?  @default("semantic")
  confidence   Float?   @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([jobId, canonical])
}

enum SourceType {
  WEB
  NEWS
  BLOG
  PDF
  SOCIAL
  VIDEO
  OTHER
}

model Source {
  id               String          @id @default(uuid())
  jobId            String?
  job              Job?            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceUrl        String
  canonicalUrl     String?
  title            String
  snippet          String
  sentiment        String          @default("neutral")
  mentions         Int             @default(1)
  domain           String?
  sourceType       SourceType      @default(WEB)
  publishedAt      DateTime?
  retrievedAt       DateTime        @default(now())
  author           String?
  publisher        String?
  contentHash      String?
  wordCount        Int?
  language         String?         @default("en")
  relevanceScore   Float?
  credibilityScore Float?
  duplicateGroup   String?
  createdAt        DateTime        @default(now())
  snapshots        SourceSnapshot[]
  claims           Claim[]

  @@index([jobId, mentions])
  @@index([domain])
  @@index([duplicateGroup])
}

model SourceSnapshot {
  id            String    @id @default(uuid())
  sourceId      String
  source        Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fetchedAt     DateTime  @default(now())
  title         String?
  snippet       String?
  sourceUrl    String?
  contentHash   String?
  rawBody       String?
  metadataJson  Json?

  @@index([sourceId, fetchedAt])
}

model Claim {
  id           String      @id @default(uuid())
  sourceId     String
  source       Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  text         String
  claimType    String?
  confidence   Float?
  createdAt    DateTime    @default(now())
  evidence     Evidence[]

  @@index([sourceId, claimType])
}

model Evidence {
  id          String    @id @default(uuid())
  claimId     String
  claim       Claim      @relation(fields: [claimId], references: [id], onDelete: Cascade)
  excerpt     String
  url         String?
  strength    Float?
  createdAt   DateTime   @default(now())

  @@index([claimId])
}
