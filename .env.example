# Single source of truth for the analytics monorepo.
# Copy this file to .env at the repository root.
# npm run dev (scripts/run-dev.js) loads .env and injects it into every service.
# In containers, supply the same variables through the process environment instead.

# Backend runtime
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://user:password@localhost:5432/analytics

# Auth — JWT_SECRET must be >= 32 chars; INTERNAL_SERVICE_KEY >= 20 chars
JWT_SECRET=replace-with-strong-random-secret
INTERNAL_SERVICE_KEY=replace-with-random-internal-key

# Downstream services (local development defaults)
DATA_ENGINE_URL=http://127.0.0.1:8001
PRESENTATION_SERVICE_URL=http://127.0.0.1:8002
SEARCH_PROVIDER=duckduckgo

# CORS
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (memory unless a Redis URL is provided)
RATE_LIMIT_STORE=memory
REDIS_URL=

# Data Engine provider credentials (optional)
# The data engine only accepts serper, tavily, or duckduckgo as providers.
# ALLOW_MOCK_PROVIDER=1 enables the 'mock' provider for local demos/tests.
SERPER_API_KEY=
TAVILY_API_KEY=

# Frontend (Next.js) build-time flags
NEXT_PUBLIC_DEMO_MODE=true